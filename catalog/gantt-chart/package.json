{
  "name": "ts-ganttchart-d3",
  "version": "1.1.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "server": "mods-dev-server dist",
    "build": "webpack --mode production --no-devtool",
    "build-watch": "webpack --watch",
    "start": "npm run build-watch",
    "dev": "concurrently \"npm:build-watch\" \"npm:server\"",
    "sbom": "node -e \"const args=process.argv.slice(1).join(' ');require('fs').writeFileSync(`${process.env.npm_package_name}-${process.env.npm_package_version}-sbom.spdx.json`, require('child_process').execSync(`npm sbom --sbom-format=spdx --omit=dev ${args}`))\" --",
    "sbom:all": "node -e \"const args=process.argv.slice(1).join(' ');require('fs').writeFileSync(`${process.env.npm_package_name}-${process.env.npm_package_version}-sbom.spdx.json`, require('child_process').execSync(`npm sbom --sbom-format=spdx ${args}`))\" --"
  },
  "author": "cnicolet, valexand, ebrandin",
  "license": "ISC",
  "dependencies": {
    "d3": "^7.9.0",
    "invert-color": "3.0.0",
    "moment": "2.31.0"
  },
  "devDependencies": {
    "@spotfire/mods-dev-server": "^1.4.0",
    "@types/d3": "^6.7.0",
    "@types/node": "17.0.23",
    "concurrently": "^10.0.6",
    "copy-webpack-plugin": "10.2.4",
    "ts-loader": "9.2.8",
    "typescript": "4.6.3",
    "webpack": "5.72.0",
    "webpack-cli": "4.9.2"
  }
}
